# Port the API listens on
PORT=3000

# Mongo. The test suite ignores this and runs an in-memory mongod.
MONGODB_URL=mongodb://127.0.0.1:27017/clinic-api

# Signing key for access and refresh tokens. At least 16 characters.
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# One-time sign-in codes
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Seconds a phone must wait before another code is sent to it
OTP_COOLDOWN_SECONDS=60
# Outside production, log the code and return it as devCode so a sign-in needs no SMS
OTP_LOG_IN_DEV=true
# The same six-digit code for every sign-in, for testing a client without an SMS
# gateway. Empty for random codes. IGNORED IN PRODUCTION whatever it says here,
# because with it set anyone who knows a phone number can sign in as its owner.
OTP_FIXED_CODE=

# Comma separated browser origins. Required in production; the React Native app
# sends no Origin header and is unaffected.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Rate limiting, always on in every environment
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Per phone number, not per IP
OTP_RATE_LIMIT_MAX=5

# Private file storage for dictation audio and prescription PDFs.
# local: files on disk, for a dev box. s3: any S3 or R2 bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
MAX_AUDIO_UPLOAD_MB=20

# SMS, for sign-in codes and "you were added"
SMS_PROVIDER=log
SMS_SENDER_ID=Clinic
# What the app is called in a text: "Install <this> and sign in with this number."
APP_NAME=the clinic app

# Voice pipeline. none fails a segment with a clear error; mock returns
# deterministic ops, for a dev box with no provider wired up.
STT_PROVIDER=none
LLM_PROVIDER=none
VOICE_SEGMENT_TIMEOUT_MS=90000

# An HTML-to-PDF service. Without one, the print file is stored as HTML.
PDF_RENDERER_URL=

# Default days dictation audio is kept after approval
AUDIO_RETENTION_DAYS=30
