# Port number
PORT=3000

# URL of the Mongo DB
# Point this at a NEW clinic database — do not reuse another project's database.
MONGODB_URL=mongodb://127.0.0.1:27017/clinic-app-db
# Mobile-app passcode auth (/v1/app-auth)
# Minutes a one-time passcode stays valid
PASSCODE_EXPIRATION_MINUTES=10
# Wrong guesses allowed before a passcode is burned
PASSCODE_MAX_ATTEMPTS=5
# In development only: log each passcode and return it as devPassCode so a
# device can log in without working SMTP. Ignored unless NODE_ENV=development.
PASSCODE_LOG_IN_DEV=true

# SMTP configuration options for the email service
# For testing, you can use a fake SMTP service like Ethereal: https://ethereal.email/create
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
